# FidelityGate Application Environment Variables
# ==============================================================================
# Public Deployment & API Gateway Configuration
# ==============================================================================
# When running locally: http://127.0.0.1:8000
# When deployed to Vercel: set to your live Render backend URL (e.g., https://fidelitygate-backend.onrender.com)
FIDELITYGATE_API_URL=http://127.0.0.1:8000
FASTAPI_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# ==============================================================================
# Canonical FastAPI Backend & Ingestion Engine
# ==============================================================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_ENV=development
DEBUG=false
DATA_ROOT=data
MAX_FILE_SIZE_MB=100

# ==============================================================================
# Python Engine & Database Persistence
# ==============================================================================
DATABASE_PATH=fidelitygate.db
PYTHON_EXEC_PATH=python
DISABLE_PYTHON_SUBPROCESS=false

# ==============================================================================
# Optional LLM Agent Configuration (Offline deterministic baseline used if unset)
# ==============================================================================
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_CALLS_PER_RUN=6
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_DAILY_CALLS=30

# ==============================================================================
# Uncertainty & Deterministic Gate Parameters
# ==============================================================================
UNCERTAINTY_BUDGET_SIMULATIONS=25
GATE_MIN_STABILITY_SCORE=0.90
GATE_MAX_ALLOWABLE_VIOLATIONS=0
